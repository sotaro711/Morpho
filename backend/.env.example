# Supabase プロジェクトの URL（ダッシュボード上部の Connect ボタン、または Settings → Data API）
SUPABASE_URL=
# Supabase Postgres の接続文字列。ダッシュボード上部の Connect → Transaction pooler（ポート 6543）の URI
# （直接接続は IPv6 のみで Cloud Run から届かないため、IPv4 のプーラー経由にする）
DATABASE_URL=
# 計算結果を保存する Firestore の GCP プロジェクト ID。ローカルでは次のどちらかで接続する:
#   - gcloud auth application-default login（実プロジェクトに接続）
#   - FIRESTORE_EMULATOR_HOST=localhost:8080（エミュレータ。プロジェクト ID は demo- で始まる任意の値でよい）
GOOGLE_CLOUD_PROJECT=
