{
  "openapi": "3.1.0",
  "info": {
    "title": "S4 RCWA Simulator API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/simulate": {
      "post": {
        "summary": "Simulate",
        "operationId": "simulate_api_simulate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/simulate/orders": {
      "post": {
        "summary": "Simulate Orders",
        "description": "反射の回折次数ごとの角度分布を返す。平面多層膜では 0 次（正反射）のみ。",
        "operationId": "simulate_orders_api_simulate_orders_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdersResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/simulate/sweep": {
      "post": {
        "summary": "Simulate Sweep",
        "description": "入射角スイープ。角度ごとの R/T スペクトルと(任意で)反射色を返す。",
        "operationId": "simulate_sweep_api_simulate_sweep_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SweepRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SweepResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AngularDistributionDTO": {
        "properties": {
          "wavelengthNm": {
            "type": "number",
            "title": "Wavelengthnm"
          },
          "orders": {
            "items": {
              "$ref": "#/components/schemas/DiffractionOrderDTO"
            },
            "type": "array",
            "title": "Orders"
          }
        },
        "type": "object",
        "required": [
          "wavelengthNm",
          "orders"
        ],
        "title": "AngularDistributionDTO",
        "description": "1 波長の角度分布。orders は出射角の昇順（伝搬する次数のみ）。"
      },
      "ColorDTO": {
        "properties": {
          "r": {
            "type": "integer",
            "title": "R"
          },
          "g": {
            "type": "integer",
            "title": "G"
          },
          "b": {
            "type": "integer",
            "title": "B"
          },
          "hex": {
            "type": "string",
            "title": "Hex"
          }
        },
        "type": "object",
        "required": [
          "r",
          "g",
          "b",
          "hex"
        ],
        "title": "ColorDTO"
      },
      "DiffractionOrderDTO": {
        "properties": {
          "order": {
            "type": "integer",
            "title": "Order"
          },
          "angleDeg": {
            "type": "number",
            "title": "Angledeg"
          },
          "reflectance": {
            "type": "number",
            "title": "Reflectance"
          }
        },
        "type": "object",
        "required": [
          "order",
          "angleDeg",
          "reflectance"
        ],
        "title": "DiffractionOrderDTO",
        "description": "1 つの回折次数への反射パワーの配分。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LayerDTO": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "thicknessNm": {
            "type": "number",
            "title": "Thicknessnm"
          },
          "n": {
            "type": "number",
            "title": "N"
          },
          "k": {
            "type": "number",
            "title": "K",
            "default": 0.0
          },
          "regions": {
            "items": {
              "$ref": "#/components/schemas/RegionDTO"
            },
            "type": "array",
            "title": "Regions",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "name",
          "thicknessNm",
          "n"
        ],
        "title": "LayerDTO"
      },
      "OrdersResponse": {
        "properties": {
          "distributions": {
            "items": {
              "$ref": "#/components/schemas/AngularDistributionDTO"
            },
            "type": "array",
            "title": "Distributions"
          }
        },
        "type": "object",
        "required": [
          "distributions"
        ],
        "title": "OrdersResponse"
      },
      "Polarization": {
        "type": "string",
        "enum": [
          "s",
          "p"
        ],
        "title": "Polarization",
        "description": "偏光。S=TE、P=TM。"
      },
      "RegionDTO": {
        "properties": {
          "xNm": {
            "type": "number",
            "title": "Xnm"
          },
          "widthNm": {
            "type": "number",
            "title": "Widthnm"
          },
          "n": {
            "type": "number",
            "title": "N"
          },
          "k": {
            "type": "number",
            "title": "K",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "xNm",
          "widthNm",
          "n"
        ],
        "title": "RegionDTO",
        "description": "層内の矩形領域（面内パターン）。単位胞左端を 0 とする nm 座標。"
      },
      "SimulationRequest": {
        "properties": {
          "wlMin": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Wlmin"
          },
          "wlMax": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Wlmax"
          },
          "wlPoints": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Wlpoints"
          },
          "thetaDeg": {
            "type": "number",
            "title": "Thetadeg",
            "default": 0.0
          },
          "pol": {
            "$ref": "#/components/schemas/Polarization",
            "default": "s"
          },
          "layers": {
            "items": {
              "$ref": "#/components/schemas/LayerDTO"
            },
            "type": "array",
            "minItems": 2,
            "title": "Layers"
          },
          "periodNm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Periodnm"
          },
          "numBasis": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Numbasis",
            "default": 1
          },
          "wavelengthsNm": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array",
                "maxItems": 2001,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Wavelengthsnm"
          }
        },
        "type": "object",
        "required": [
          "wlMin",
          "wlMax",
          "wlPoints",
          "layers"
        ],
        "title": "SimulationRequest"
      },
      "SimulationResponse": {
        "properties": {
          "wavelengths": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Wavelengths"
          },
          "R": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "R"
          },
          "T": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "T"
          },
          "reflectedColor": {
            "$ref": "#/components/schemas/ColorDTO"
          }
        },
        "type": "object",
        "required": [
          "wavelengths",
          "R",
          "T",
          "reflectedColor"
        ],
        "title": "SimulationResponse"
      },
      "SweepEntryDTO": {
        "properties": {
          "thetaDeg": {
            "type": "number",
            "title": "Thetadeg"
          },
          "R": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "R"
          },
          "T": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "T"
          },
          "color": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ColorDTO"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "thetaDeg",
          "R",
          "T"
        ],
        "title": "SweepEntryDTO",
        "description": "1 入射角分の結果。キーは SimulationResponse に合わせて R / T。"
      },
      "SweepRequest": {
        "properties": {
          "wlMin": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Wlmin"
          },
          "wlMax": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Wlmax"
          },
          "wlPoints": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Wlpoints"
          },
          "thetaDeg": {
            "type": "number",
            "title": "Thetadeg",
            "default": 0.0
          },
          "pol": {
            "$ref": "#/components/schemas/Polarization",
            "default": "s"
          },
          "layers": {
            "items": {
              "$ref": "#/components/schemas/LayerDTO"
            },
            "type": "array",
            "minItems": 2,
            "title": "Layers"
          },
          "periodNm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Periodnm"
          },
          "numBasis": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Numbasis",
            "default": 1
          },
          "wavelengthsNm": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array",
                "maxItems": 2001,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Wavelengthsnm"
          },
          "thetaDegs": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 181,
            "minItems": 1,
            "title": "Thetadegs"
          },
          "includeColors": {
            "type": "boolean",
            "title": "Includecolors",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "wlMin",
          "wlMax",
          "wlPoints",
          "layers",
          "thetaDegs"
        ],
        "title": "SweepRequest",
        "description": "入射角スイープのリクエスト。theta_deg の代わりに theta_degs を掃引する。"
      },
      "SweepResponse": {
        "properties": {
          "wavelengths": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Wavelengths"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/SweepEntryDTO"
            },
            "type": "array",
            "title": "Entries"
          }
        },
        "type": "object",
        "required": [
          "wavelengths",
          "entries"
        ],
        "title": "SweepResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
